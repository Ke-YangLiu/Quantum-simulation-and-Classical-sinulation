import numpy as np
from qiskit.quantum_info import Statevector
import matplotlib.pyplot as plt
from scipy.linalg import expm
from qiskit.visualization import plot_bloch_vector

# 系统参数和初始化
omega = 2 * np.pi * 0.5
sigma_x = np.array([[0, 1], [1, 0]])
H = omega * sigma_x / 2
psi0 = Statevector.from_int(0, 2)

# 时间演化
def time_evolution(psi0, H, t):
    U = expm(-1j * H * t)
    return Statevector(U @ psi0.data)

# 模拟
times = np.linspace(0, 2, 100)
states = [time_evolution(psi0, H, t) for t in times]

# 计算概率
prob_0 = [abs(state.data[0])**2 for state in states]
prob_1 = [abs(state.data[1])**2 for state in states]

# 创建图形
fig = plt.figure(figsize=(14, 6))

# 左图：概率演化
ax1 = plt.subplot(1, 2, 1)
plt.plot(times, prob_0, label='|0⟩概率', linewidth=2)
plt.plot(times, prob_1, label='|1⟩概率', linewidth=2)
plt.xlabel('时间', fontsize=12)
plt.ylabel('概率', fontsize=12)
plt.legend(fontsize=12)
plt.title('量子比特含时演化', fontsize=14)
plt.grid(True, alpha=0.3)

# 右图：布洛赫球
ax2 = plt.subplot(1, 2, 2, projection='3d')

# 计算并绘制多个时间点的态
colors = plt.cm.rainbow(np.linspace(0, 1, 5))
time_points = [0, 25, 50, 75, 99]

for i, idx in enumerate(time_points):
    state = states[idx]
    # 计算布洛赫向量
    x = state.expectation_value(sigma_x)
    y = state.expectation_value(np.array([[0, -1j], [1j, 0]]))
    z = state.expectation_value(np.array([[1, 0], [0, -1]]))
    
    # 绘制向量
    ax2.quiver(0, 0, 0, x, y, z, color=colors[i], 
               arrow_length_ratio=0.1, linewidth=2,
               label=f't={times[idx]:.2f}')

ax2.set_title('布洛赫球表示', fontsize=14)
ax2.set_xlim([-1, 1])
ax2.set_ylim([-1, 1])
ax2.set_zlim([-1, 1])
ax2.legend(fontsize=10)
ax2.view_init(elev=20, azim=45)

plt.tight_layout()
plt.show()
