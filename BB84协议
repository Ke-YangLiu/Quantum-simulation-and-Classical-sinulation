    # 计算安全指标
    if alice_key and bob_key:
        metrics = BB84Analyzer.calculate_security_metrics(alice_key, bob_key, error_rate)
        print(f"\n安全指标分析:")
        for key, value in metrics.items():
            print(f"  {key}: {value}")
    
    # 运行多次试验
    run_multiple_trials(num_trials=3, bits_per_trial=80)
